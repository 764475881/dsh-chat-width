{
  "name": "dsh-chat-width",
  "version": "0.2.0",
  "description": "调宽 dsh 网页会话区的聊天内容与用户消息气泡宽度（默认 748px → 1040px；右缘把手拖拽可调，控制台 __setChatWidth(px) / __setUserBubbleRatio(r) 亦可）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/764475881/dsh-chat-width.git"
  },
  "homepage": "https://github.com/764475881/dsh-chat-width",
  "bugs": {
    "url": "https://github.com/764475881/dsh-chat-width/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "chat-width",
    "ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
}
